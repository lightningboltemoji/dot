// emira's desktop, a snapshot per change, under `emira` in the store. No bubble.
// `emira watch` exits at once while the daemon is down, so retry often: back within 5s of it.
source "emira" module="exec" interval="watch" max-backoff="5s" {
  command "emira" "watch"
}

// On while the desktop moves, and for 700ms after the last change or movement.
mode "guide" {
  while "emira.moving"
  changed "emira.focus" "emira.displays"
  hold "700ms"
}

// Ping's reading of the Dock, under `ping`: every app's badge, and whether it was acknowledged
// or snoozed. No bubble. `watch` exits at once while Ping is down, so retry often.
source "ping" module="exec" interval="watch" max-backoff="5s" {
  command "/Applications/Ping.app/Contents/MacOS/ping-dot-app" "watch"
}

// The display's and the keyboard's brightness, under `brightness`, for the control centre.
source "brightness" module="brightness"

// Text that turns over as on a drum, for the workspace bubble.
renderer "roll" path="~/.config/bario/renderers/roll.wasm"

bar {
  // The same on every display, down from the top of the screen: the MacBook's menu bar. On
  // the Studio Display (30pt menu bar) it hangs 8pt below the menu bar.
  height 38
  hole radius=120 feather=0 proximity=0 click="reveal"
  option "reveal"
  position "fixed"
  // Over a full screen app only where it leaves room: in the black strip beside the notch, and
  // off the Studio Display, where the app has the whole screen. The bar wears `fullscreen`.
  fullscreen "if-room"

  // A click opens the Apple menu. A right click keeps the display awake or lets it sleep; it
  // shines while awake. -w ends caffeinate with bario ($PPID), even if bario crashes rather than
  // quits.
  item "apple" module="exec" interval="watch" running=#false on-click="menu" on-right-click="toggle" {
    command "exec caffeinate -d -w $PPID"
    content {
      // The logo where the icon drew it, centred at (13, 10.35), with its shine either side:
      // three ticks each, level and 25° above and below, 9.75pt to 12pt out from the middle.
      canvas width=26 height=21 {
        image "apple.logo" { rect 6.7 2.3 13 16 }
        stroke "var(--shine)" width=1.5 cap="round" {
          move 21.84 6.23; line 23.88 5.28
          move 22.75 10.35; line 25 10.35
          move 21.84 14.47; line 23.88 15.42
          move 4.16 6.23; line 2.12 5.28
          move 3.25 10.35; line 1 10.35
          move 4.16 14.47; line 2.12 15.42
        }
      }
    }
    menu {
      row class="awake" on-click="toggle" keep-open=#true {
        icon "cup.and.saucer.fill" class="glyph"; text "Keep awake"; spacer; icon "checkmark" class="check"
      }
      separator
      row on-click="exec open 'x-apple.systempreferences:com.apple.SystemProfiler.AboutExtension'" { text "About This Mac" }
      row on-click="exec open -b com.apple.systempreferences" { text "System Settings…" }
      separator
      row on-click="exec pmset sleepnow" { text "Sleep" }
      row on-click=#"exec osascript -e 'tell app "loginwindow" to «event aevtrrst»'"# { text "Restart…" }
      row on-click=#"exec osascript -e 'tell app "loginwindow" to «event aevtrsdn»'"# { text "Shut Down…" }
      separator
      row on-click="key ctrl+cmd+q" { text "Lock Screen" }
    }
  }
  // One bubble: emira's focused workspace, then the app in front.
  group "focus" {
    // Its name alone, from the source. It rolls as emira pans: up to a later workspace, down
    // to an earlier one.
    item "workspace" module="wasm" path="~/.config/bario/modules/emira-workspace.wasm" {
      config source="emira" roll=#true
    }
    item "app" module="front-app" priority=10 format="{name}" max-length=28 unless="guide" on-click="menu"
  }
  spacer
  group "badges" unless="guide" {
    item "slack" module="wasm" path="~/.config/bario/modules/ping-badge.wasm" on-click="exec open -a Slack" {
      config app="Slack" icon="number" dot="" hide="quiet"
    }
    item "messages" module="wasm" path="~/.config/bario/modules/ping-badge.wasm" on-click="exec open -a Messages" {
      config app="Messages" hide="quiet"
    }
  }
  item "names" module="wasm" path="~/.config/bario/modules/emira-names.wasm" when="guide" {
    config source="emira" max=7
  }
  spacer
  notch
  spacer
  group "system" {
    // What the machine is drawing now, over its 30s average. The bolt fills with `level`, and is
    // full when a full battery would last 2 hours or less. Its bottom 4pt are always lit, since
    // the tip is too thin to see at idle. Drawn by hand, as a symbol cannot be a clip.
    item "power" module="power" interval="1s" windows="30s" {
      content {
        row align="center" gap=13 {
          canvas width=12 height=20 {
            fill "color-mix(in oklch, var(--item-fg) 15%, transparent)" {
              move 7.5 0.5; line 1 11.5; line 5.4 11.5; line 4.5 19.5; line 11 8; line 6.6 8; close
            }
            clip {
              move 7.5 0.5; line 1 11.5; line 5.4 11.5; line 4.5 19.5; line 11 8; line 6.6 8; close
            }
            translate 0 16
            scale 1 -16
            fill "var(--glow)" { rect 0 -0.25 12 0.25; rect 0 0 12 "{level}"; }
          }
          column class="stacked" align="end" {
            text "{draw:watts}"
            text "{draw-30s:watts}"
          }
        }
      }
    }
    item "cpu" module="cpu" interval="1s" windows="5s 1m" history="40s" {
      warn 70
      critical 90
      content {
        row align="stretch" {
          graph values="{history}" max=1 kind="area" scroll="smooth" width=28
          column class="stacked" align="end" {
            text "{load-5s:%3.0f}%"
            text "{load-1m:%3.0f}%"
          }
        }
      }
    }
    // The meter preset, stacked to the height of its neighbours' two lines.
    item "mem" module="mem" interval="2s" {
      content {
        column class="stacked" align="center" {
          meter value="{pressure-fraction}" width=22
          text "{pressure-pct:%.0f}%"
        }
      }
    }
    // The stacked preset, with each arrow its own text so the stylesheet can space it off.
    item "net" module="net" interval="1s" {
      content {
        column class="stacked" align="end" {
          row { text "↑"; text "{tx:rate-short}"; }
          row { text "↓"; text "{rx:rate-short}"; }
        }
      }
    }
  }
  spacer
  group "status" {
    item "wifi" module="wifi" format="{icon}" on-click="menu"
    item "volume" module="volume" format="{icon}" on-click="menu"
    item "battery" module="battery" format="{icon} {pct}%" on-click="menu" {
      low 20
    }
  }
  // A click opens Notification Center, with the system's own shortcut for it.
  item "clock" module="clock" format="EEE, MMM d ⌘ h:mm:ss" priority=10 on-click="key fn+n"
  // A control centre: brightness as sliders. A group of its own, at the end of the bar.
  group "controls" {
    item "settings" module="text" on-click="menu" {
      content { icon "gearshape.fill" }
      menu align="end" {
        if "/brightness.has-display" {
          row { icon "sun.max.fill" class="glyph"; slider value="{/brightness.display}" on-change="send brightness set-display" }
        }
        if "/brightness.has-keyboard" {
          row { icon "light.max" class="glyph"; slider value="{/brightness.keyboard}" on-change="send brightness set-keyboard" }
        }
      }
    }
  }
}
