# fast focus desktop
alt - x : yabai -m space --focus recent
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - q : yabai -m space --focus 6
alt - w : yabai -m space --focus 7
alt - e : yabai -m space --focus 8
alt - r : yabai -m space --focus 9
alt - t : yabai -m space --focus 10

# send window to desktop
shift + alt - 1 : yabai -m window --space 1
shift + alt - 2 : yabai -m window --space 2
shift + alt - 3 : yabai -m window --space 3
shift + alt - 4 : yabai -m window --space 4
shift + alt - 5 : yabai -m window --space 5
shift + alt - q : yabai -m window --space 6
shift + alt - w : yabai -m window --space 7
shift + alt - e : yabai -m window --space 8
shift + alt - r : yabai -m window --space 9
shift + alt - t : yabai -m window --space 10

alt - space: osascript -e 'tell application "Ghostty" to new window'
